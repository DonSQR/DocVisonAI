<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/item_pdf"
    android:gravity="center_vertical">


    <ImageView
        android:id="@+id/pdf_image"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_gravity="center"
        android:layout_marginLeft="10dp"
        android:src="@mipmap/pdf_selected"

        />

    <TextView
        android:id="@+id/pdf_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="10dp"
        android:layout_toRightOf="@id/pdf_image"

        android:textSize="28sp" />
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="right"

    >

    <Button
        android:id="@+id/item_deleta_btn"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/item_delect_pic"
        android:layout_toEndOf="@+id/pdf_name"
        android:layout_toRightOf="@+id/pdf_name"
        android:gravity="right"
        android:visibility="gone"
        />
</LinearLayout>



</RelativeLayout>