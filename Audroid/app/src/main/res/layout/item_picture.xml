<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >


    <ImageView
        android:id="@+id/item_jpg"
        android:layout_width="200dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:layout_margin="5dp"
        android:src="@mipmap/ic_launcher_round"

        />

    <Button
        android:id="@+id/deleta_pic"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_alignRight="@id/item_jpg"
        android:background="@drawable/red_deleat"
        android:visibility="gone"
        android:layout_marginTop="12dp"

         />
    <Button
        android:id="@+id/add_pic"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_toLeftOf="@id/exchange_pic"
        android:background="@drawable/add_red"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:layout_marginRight="20dp"
        />
    <Button
        android:id="@+id/exchange_pic"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_toLeftOf="@id/deleta_pic"
        android:background="@drawable/exchange"
        android:visibility="gone"
        android:layout_marginRight="20dp"
        android:layout_marginTop="12dp"
        />
</RelativeLayout>